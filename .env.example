VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 서버 전용: 브라우저에 노출되는 VITE_ 접두사를 붙이지 않습니다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
# 선택: 미설정 시 인생관리AI앱 <onboarding@resend.dev>
APPLICANT_ALERT_FROM=
CRON_SECRET=

# 외부 API(/api/v1) — 소장님 본인 계정 기록을 클로드 코드·디스코드에서 조작
# 토큰 원문은 넣지 않는다. scripts/led-api/new-token.mjs가 만든 64자리 SHA-256 해시만 넣는다.
LED_API_TOKEN_SHA256=
# API가 조작할 앱 계정의 로그인 이메일 (profiles.email과 정확히 일치)
LED_API_USER_EMAIL=
